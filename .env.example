# Since .env is gitignored, copy this file to `.env` and fill in real values.
# Keep this file up-to-date when you add new variables. Never commit `.env`.

# PostgreSQL (Neon). Use the pooled connection string for the app; drizzle-kit
# uses the same URL. Example: postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/npa"

# better-auth. Generate the secret via `openssl rand -base64 32`.
# @see https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET="supersecret"
BETTER_AUTH_URL="http://localhost:3000"

# UploadThing — event posters + refund transfer-receipt uploads.
# @see https://uploadthing.com/dashboard -> API Keys
UPLOADTHING_TOKEN=""

# Resend — transactional emails (order/refund status).
# @see https://resend.com/api-keys
RESEND_API_KEY=""

# HitPay payment gateway.
# @see https://dashboard.sandbox.hit-pay.com -> Settings -> Payment Gateway (key + salt)
#   - Sandbox: use the sandbox URL + a test_ key, and set HITPAY_CURRENCY=SGD
#     (the Singapore sandbox does not support PHP/GCash).
#   - Production: use https://api.hit-pay.com/v1/, a live key, HITPAY_CURRENCY=PHP,
#     and a verified Philippines account.
HITPAY_API_KEY=""
HITPAY_SALT=""
HITPAY_API_URL="https://api.sandbox.hit-pay.com/v1/"
HITPAY_CURRENCY="PHP"
# Optional: restrict checkout to specific methods (CSV, e.g. "card,gcash"). Leave
# empty to show every method enabled on your HitPay account. Only list methods
# you've enabled in the dashboard, or HitPay returns a 422.
HITPAY_PAYMENT_METHODS=""
